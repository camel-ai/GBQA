# Copy to evidence_quality.toml and configure task.toml [verifier.env] API keys
# to enable LLM-as-a-judge scoring. Rewardkit ignores *.toml.example files.

[judge]
judge = "anthropic/claude-sonnet-4-6"
files = ["/logs/agent/gbqa/bugs.json", "/logs/agent/gbqa/report.md"]

[[criterion]]
description = "Does each reported bug include concrete reproduction evidence?"
type = "binary"

[[criterion]]
description = "How actionable is the strongest reported bug for engineers?"
type = "likert"
points = 5

[scoring]
aggregation = "weighted_mean"
