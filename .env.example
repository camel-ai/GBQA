# GBQA runtime credentials
# Copy this file to `.env` at the repository root.

# Required for Harbor + Daytona M1 remote sandbox runs.
DAYTONA_API_KEY=

# Required for GBQA agent runs.
API_KEY=
BASE_URL=https://zenmux.ai/api/v1
MODEL_NAME=

# Optional for authenticated benchmark sourcing from GitHub.
GITHUB_TOKEN=
