# GBQA runtime credentials
# Copy this file to `.env` at the repository root.

# Required for Harbor + Daytona M1 remote sandbox runs.
DAYTONA_API_KEY=

# Required for GBQA agent runs.
API_KEY=
BASE_URL=https://zenmux.ai/api/v1
MODEL_NAME=

# Optional for Rewardkit LLM-as-a-Judge verifier scoring.
# Use openai/... with ZenMux/OpenAI-compatible credentials, or set to
# claude-code / codex to use Rewardkit's agent judge backends.
REWARDKIT_JUDGE=openai/gpt-4o
OPENAI_API_KEY=
OPENAI_API_BASE=https://zenmux.ai/api/v1
OPENAI_BASE_URL=https://zenmux.ai/api/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional subscription auth for Harbor/Rewardkit Claude Code and Codex CLIs.
# Claude Code: run `claude setup-token`, then set CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_CODE_OAUTH_TOKEN=
# Codex: run `codex login`; for Harbor's codex agent use CODEX_FORCE_AUTH_JSON=1
# or CODEX_AUTH_JSON_PATH. For verifier containers, CODEX_AUTH_JSON_B64 is the
# portable form: base64 -w0 ~/.codex/auth.json.
CODEX_FORCE_AUTH_JSON=
CODEX_AUTH_JSON_PATH=
CODEX_AUTH_JSON_B64=

# Optional for authenticated benchmark sourcing from GitHub.
GITHUB_TOKEN=
